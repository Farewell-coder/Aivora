{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Farewell-coder/Aivora/protocol/AEX-SCHEMA.json",
  "title": "AEX 1.1 Payload",
  "description": "Aivora Exchange Protocol 1.1 解密后的配置载荷结构（Draft）。1.1 起 profiles[] 不再包含 models 与 defaultModel。",
  "type": "object",
  "required": ["format", "protocolVersion", "exportedAt", "exporter", "profiles"],
  "additionalProperties": true,
  "properties": {
    "format": {
      "const": "aivora.exchange/1"
    },
    "protocolVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "exporter": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "platform": { "type": "string" }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "provider": { "type": "string" },
        "baseUrl": { "type": "string" },
        "apiKey": { "type": "string" },
        "description": { "type": "string" },
        "extra": {
          "type": "object",
          "description": "扩展字段。键名必须使用反域名命名空间，例如 com.example.tool.retryPolicy。",
          "propertyNames": { "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)+$" }
        }
      }
    }
  }
}